# ui/screens/login.py

import flet as ft
from core.security.auth import AuthService

__all__ = ["LoginScreen"]


class LoginScreen(ft.Container):
    """Initial entry point handling credential collection and UI feedback."""

    def __init__(self, page: ft.Page) -> None:
        super().__init__(
            expand=True,
            alignment=ft.Alignment.CENTER,
        )

        self._page = page

        self.username_field = ft.TextField(
            label="Username",
            autofocus=True,
        )
        
        # Password prefill strictly removed for security
        self.password_field = ft.TextField(
            label="Password",
            password=True,
            can_reveal_password=True,
        )

        self.error_text = ft.Text(color=ft.Colors.RED_600, size=14)

        self.content = ft.Card(
            elevation=5,
            content=ft.Container(
                width=400,
                padding=40,
                content=ft.Column(
                    tight=True,
                    spacing=25,
                    horizontal_alignment=ft.CrossAxisAlignment.CENTER,
                    controls=[
                        ft.Icon(
                            ft.Icons.ACCOUNT_CIRCLE,
                            size=80,
                        ),
                        ft.Text(
                            "SIMS v2.2",
                            size=28,
                            weight=ft.FontWeight.BOLD,
                        ),
                        self.username_field,
                        self.password_field,
                        self.error_text,
                        ft.ElevatedButton(
                            content=ft.Text("Login to ERP"),
                            icon=ft.Icons.LOGIN,
                            width=200,
                            height=45,
                            on_click=self.handle_login,
                        ),
                    ],
                ),
            ),
        )

    def handle_login(self, e: ft.ControlEvent) -> None:
        """Validates input and requests authentication via AuthService."""
        self.error_text.value = ""
        self.update()

        username = self.username_field.value or ""
        password = self.password_field.value or ""

        if not username.strip() or not password.strip():
            self.error_text.value = "Username and password cannot be empty."
            self.update()
            return

        # Core Auth Boundary Check
        user = AuthService.authenticate(username, password)
        
        if user:
            AuthService.login(self._page, user)
            self._page.navigate("/dashboard")
        else:
            self.error_text.value = "Invalid username or password."
            self.password_field.value = ""
            self.update()
